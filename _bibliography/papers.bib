@article{chowdhury_ultrafast_2020-1,
	bibtex_show = {true},
	title = {Ultrafast {Investigation} of {Individual} {Bright} {Exciton}–{Plasmon} {Polaritons} in {Size}‐{Tunable} {Metal}–{WS}$_{\textrm{2}}$ {Hybrid} {Nanostructures}},
	volume = {8},
	issn = {2195-1071, 2195-1071},
	url = {https://advanced.onlinelibrary.wiley.com/doi/10.1002/adom.201901645},
	doi = {10.1002/adom.201901645},
	abstract = {Abstract
            
              Strong light–matter interactions between resonantly coupled metal plasmons and spin–orbit‐coupled bright excitons from 2D transition metal dichalcogenides (TMDs) can produce discrete bright exciton–plasmon polaritons (plexcitons). A few efforts have been made to perceive the spin‐induced exciton‐polaritons in nanocavities at cryogenic conditions, however, successful realization of bright plexcitons in time domain is still lacking. Here, both the bright plexcitons are identified discretely at room temperature and their ultrafast temporal dynamics in size‐tunable Au–WS
              2
              hybrid nanostructures are investigated using a helicity‐controlled femtosecond pump‐probe spectroscopy technique. The zero detuning between both the bright excitons and plasmons is achieved at ≈7.0 ps, matching with the stable plexciton formation time. The Rabi‐splitting energy is as high as ≈250 meV for both the plexcitons, validating the strong‐coupling conditions of polariton formation. Realization of these novel bright exciton–plasmon interactions in the metal–TMDs platform is, therefore, interesting for both fundamental understanding and their possible futuristic applications in quantum photonics operating at room temperature.},
	language = {en},
	number = {10},
	urldate = {2025-12-03},
	abbr = {Advanced Optical Materials},
